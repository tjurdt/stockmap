{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tjurdt/stockmap/schema/history.schema.json",
  "title": "StockMap daily factor history row",
  "description": "data/history/factors-YYYY.jsonl 的單列 schema。每交易日 append 一列，供回測 / 因子績效使用。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "date", "stocks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "stocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "close", "adjClose", "mcap", "pe", "pb", "dy", "mom20", "mom60", "mom121"],
        "properties": {
          "code": { "type": "string", "pattern": "^\\d{4}$" },
          "close": { "type": ["number", "null"] },
          "adjClose": { "type": ["number", "null"], "description": "還原權值收盤價" },
          "mcap": { "type": ["number", "null"] },
          "pe": { "type": ["number", "null"] },
          "pb": { "type": ["number", "null"] },
          "dy": { "type": ["number", "null"] },
          "mom20": { "type": ["number", "null"] },
          "mom60": { "type": ["number", "null"] },
          "mom121": { "type": ["number", "null"] }
        }
      }
    }
  }
}
