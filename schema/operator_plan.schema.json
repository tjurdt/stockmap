{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tjurdt/stockmap/schema/operator_plan.schema.json",
  "title": "StockMap operator plan",
  "description": "操作計畫：策略設定 + 上線日 + 交易日誌 / 目前持股。存在瀏覽器 localStorage（每台裝置一份）。前端 zod schema 見 web/src/lib/plan.ts。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "startDate", "strategy", "holdings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "startDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "策略上線日；此日之前只顯示「上線當天要買的目標清單」"
    },
    "strategy": { "$ref": "#/definitions/strategy" },
    "holdings": {
      "type": "array",
      "items": { "$ref": "#/definitions/position" },
      "description": "目前實際持股；空陣列 = 尚未進場。有 trades 時由交易日誌推算，勿手改"
    },
    "trades": {
      "type": "array",
      "items": { "$ref": "#/definitions/trade" },
      "description": "交易日誌（選填）。有這個欄位時 holdings 由它推算：股數、加權平均成本、這一段持有的起算日"
    }
  },
  "definitions": {
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor", "momDays", "momSkip", "customFormula", "customLabel", "customBetterWhen",
        "topN", "poolTopN", "rebalance", "rebalanceDay", "weighting",
        "execLagDays", "stopType", "stopPct", "stopMaDays", "stopExecNext",
        "swapOnBetter", "swapMargin", "swapMarginMode", "swapMinHoldDays", "swapExecNext",
        "regime", "regimeDays", "regimeExit", "bearHolding"
      ],
      "properties": {
        "factor": {
          "enum": ["price", "mcap", "pe", "pb", "dy", "chg", "turn", "m20", "m60", "m121", "custom"],
          "description": "排名因子 key（對齊 web/src/lib/metrics.ts）；custom = 使用者自訂指標"
        },
        "momDays": {
          "type": "integer",
          "minimum": 0,
          "description": "自訂動能回看天數（0 = 用因子內建；只在 factor 是 m20/m60/m121 時生效）"
        },
        "momSkip": {
          "type": "integer",
          "minimum": 0,
          "description": "自訂動能跳過最近幾個交易日（0 = 不跳）"
        },
        "customFormula": {
          "type": "string",
          "description": "使用者自訂指標運算式（只在 factor==='custom' 時有意義，空字串 = 未設定）"
        },
        "customLabel": {
          "type": "string",
          "description": "自訂指標顯示名稱（factor==='custom' 時用；空字串 = 未命名）"
        },
        "customBetterWhen": {
          "enum": ["high", "low"],
          "description": "自訂指標排序方向：數值越大/越小越好（factor==='custom' 時用）"
        },
        "topN": { "type": "integer", "minimum": 1, "description": "持股檔數" },
        "poolTopN": { "type": "integer", "minimum": 1, "description": "選股池：當日市值前 N 大" },
        "rebalance": { "enum": ["W", "M"], "description": "再平衡頻率：每週 / 每月" },
        "rebalanceDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 23,
          "description": "換股時點：M→每月第 N 個交易日；W→每週星期幾 (1=一 … 5=五)"
        },
        "weighting": { "enum": ["equal", "mcap"], "description": "等權 / 市值權重" },
        "execLagDays": { "enum": [0, 1], "description": "訊號日到成交隔幾個交易日" },
        "stopType": {
          "enum": ["none", "fixed", "trailing", "daily", "ma"],
          "description": "停損型態：固定 / 移動 / 單日跌幅 / 跌破均線"
        },
        "stopPct": { "type": "number", "exclusiveMinimum": 0, "description": "停損百分比（ma 型態不用）" },
        "stopMaDays": { "type": "integer", "minimum": 1, "description": "stopType=ma 的均線天數" },
        "stopExecNext": {
          "type": "boolean",
          "description": "停損成交時點：false=觸發當日收盤、true=隔一交易日收盤"
        },
        "swapOnBetter": {
          "type": "boolean",
          "description": "動能換股：非排程日也監看排名，池內未持有股票因子明顯優於最弱持股就換"
        },
        "swapMargin": {
          "type": "number",
          "minimum": 0,
          "description": "動能換股門檻：挑戰者因子需比最弱持股好過此量，意義由 swapMarginMode 決定"
        },
        "swapMarginMode": {
          "enum": ["relative", "absolute"],
          "description": "relative=swapMargin 是最弱持股因子值的 %；absolute=swapMargin 是因子原始單位的差值"
        },
        "swapMinHoldDays": {
          "type": "integer",
          "minimum": 0,
          "description": "動能換股：每檔進場後至少持有 N 個交易日才可被換掉"
        },
        "swapExecNext": {
          "type": "boolean",
          "description": "動能換股成交時點：true=隔一交易日收盤、false=訊號日收盤"
        },
        "regime": { "enum": ["off", "ma", "mom"], "description": "大盤多空過濾指標" },
        "regimeDays": { "type": "integer", "minimum": 1, "description": "多空指標回看天數" },
        "regimeExit": {
          "enum": ["rebalance", "immediate"],
          "description": "轉空反應：撐到換股日 / 立刻清空"
        },
        "bearHolding": {
          "enum": ["cash", "inverse"],
          "description": "空頭時手上放：現金 / 元大台灣50反1 (00632R)"
        }
      }
    },
    "trade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "code", "side", "shares", "price"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "穩定 id，供編輯 / 刪除" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "成交日" },
        "code": { "type": "string", "pattern": "^\\d{4}$" },
        "side": { "enum": ["buy", "sell"], "description": "買進 / 賣出" },
        "shares": { "type": "number", "exclusiveMinimum": 0 },
        "price": { "type": "number", "exclusiveMinimum": 0, "description": "成交價" }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "shares", "entryPrice", "entryDate"],
      "properties": {
        "code": { "type": "string", "pattern": "^\\d{4}$" },
        "shares": { "type": "number", "exclusiveMinimum": 0 },
        "entryPrice": { "type": "number", "exclusiveMinimum": 0 },
        "entryDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
