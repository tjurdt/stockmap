{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tjurdt/stockmap/schema/snapshot.schema.json",
  "title": "StockMap daily snapshot",
  "description": "data/latest.json — 前端唯一資料契約。加欄位須往後相容；破壞性變更才 bump schemaVersion。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "asOf", "generatedAt", "histLen", "stocks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "交易日 (以 TWSE API 回報的 Date 為準，非執行機時鐘)"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "管線產出時間 (Asia/Taipei)"
    },
    "histLen": {
      "type": "integer",
      "minimum": 0,
      "description": "最長還原價序列的交易日數；動能欄位在序列不足時為 null"
    },
    "universeRankedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "市值前 20 名單最後一次自動重排的日期（無此欄位表示名單為手動維護）"
    },
    "stocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/stock" }
    }
  },
  "definitions": {
    "nullableNumber": { "type": ["number", "null"] },
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code", "name", "close", "chgPct", "mcap", "value",
        "pe", "pb", "dy", "mom20", "mom60", "mom121"
      ],
      "properties": {
        "code": { "type": "string", "pattern": "^\\d{4}$" },
        "name": { "type": "string", "minLength": 1 },
        "close": { "$ref": "#/definitions/nullableNumber", "description": "收盤價 (元)" },
        "chgPct": { "$ref": "#/definitions/nullableNumber", "description": "當日漲跌幅 (%)" },
        "mcap": { "$ref": "#/definitions/nullableNumber", "description": "市值 (億元)" },
        "value": { "$ref": "#/definitions/nullableNumber", "description": "成交金額 (億元)" },
        "pe": { "$ref": "#/definitions/nullableNumber", "description": "本益比" },
        "pb": { "$ref": "#/definitions/nullableNumber", "description": "股價淨值比" },
        "dy": { "$ref": "#/definitions/nullableNumber", "description": "殖利率 (%)" },
        "mom20": { "$ref": "#/definitions/nullableNumber", "description": "近月動能 (%)，20 交易日" },
        "mom60": { "$ref": "#/definitions/nullableNumber", "description": "近季動能 (%)，60 交易日" },
        "mom121": { "$ref": "#/definitions/nullableNumber", "description": "12-1 動能 (%)，回看 250 日跳過最近 20 日" }
      }
    }
  }
}
