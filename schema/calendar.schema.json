{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tjurdt/stockmap/schema/calendar.schema.json",
  "title": "StockMap trading calendar",
  "description": "data/calendar.json — 台股休市日（平日但市場不交易）。前端用來算下一個交易日 / 每月第 N 個交易日。由 twse_pipeline.calendar 產生。",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "years", "holidays"],
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "years": {
      "type": "array",
      "items": { "type": "integer", "minimum": 2000 }
    },
    "holidays": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "uniqueItems": true
    }
  }
}
