{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tjurdt/stockmap/schema/backtest_universe.schema.json",
  "title": "StockMap backtest universe",
  "description": "回測選股池 — 過去 N 年曾進市值前段的股票聯集。由 twse_pipeline.universe_history 產生。",
  "type": "object",
  "additionalProperties": false,
  "required": ["constituents"],
  "properties": {
    "$comment": { "type": "string" },
    "builtAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "years": { "type": "integer", "minimum": 1 },
    "constituents": {
      "type": "array",
      "minItems": 50,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "sharesOutstandingM"],
        "properties": {
          "code": { "type": "string", "pattern": "^\\d{4}$" },
          "name": { "type": "string", "minLength": 1 },
          "sharesOutstandingM": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
