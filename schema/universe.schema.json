{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tjurdt/stockmap/schema/universe.schema.json",
  "title": "StockMap universe",
  "description": "schema/universe.json — 市值前 N 大成分股。由 twse_pipeline.universe_rank 每週重排。",
  "type": "object",
  "required": ["constituents"],
  "properties": {
    "$comment": { "type": "string" },
    "asOf": { "type": "string" },
    "rankedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "constituents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "sharesOutstandingM"],
        "properties": {
          "code": { "type": "string", "pattern": "^\\d{4}$" },
          "name": { "type": "string", "minLength": 1 },
          "sharesOutstandingM": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
